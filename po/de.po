#: lib/countdown.js:28
msgid "now"
msgstr "jetzt"

#. Translators: compact countdown — d = days, h = hours.
#: lib/countdown.js:36
#, javascript-format
msgid "%dd %dh"
msgstr "%dT %dh"

#. Translators: compact countdown — h = hours, m = minutes (zero-padded).
#: lib/countdown.js:38
#, javascript-format
msgid "%dh %02dm"
msgstr "%dh %02dm"

