#. Translators: compact countdown — d = days, h = hours.
#: lib/countdown.js:17
#, javascript-format
msgid "%dd %dh"
msgstr "%dT %dh"

#. Translators: compact countdown — h = hours, m = minutes (zero-padded).
#: lib/countdown.js:19
#, javascript-format
msgid "%dh %02dm"
msgstr "%dh %02dm"

