msgstr "Limit: %s"

#. Translators: %s is the Anthropic plan name (e.g. "Max 5x") — kept verbatim.
#: lib/vendors/anthropic/section.js:62
#, javascript-format
msgid "Claude %s"
msgstr "Claude %s"

#: lib/vendors/deepseek/section.js:16 lib/vendors/openrouter/section.js:18
msgid "Balance"
msgstr "Guthaben"

#. Translators: %s are money amounts (granted credit, topped-up credit).
#: lib/vendors/deepseek/section.js:20
#, javascript-format
msgid "granted %s · topped-up %s"
msgstr "gewährt %s · aufgeladen %s"

#: lib/vendors/deepseek/section.js:28
msgid "API available"
msgstr "API verfügbar"

#: lib/vendors/deepseek/section.js:28
msgid "API unavailable"
msgstr "API nicht verfügbar"

#: lib/vendors/openai/section.js:32
msgid "Codex 5h"
msgstr "Codex 5h"

#: lib/vendors/openai/section.js:33
msgid "Codex weekly"
msgstr "Codex wöchentlich"

#: lib/vendors/openai/section.js:35
msgid "Code review (weekly)"
msgstr "Code-Review (wöchentlich)"

#: lib/vendors/openai/section.js:39
msgid "Credits"
msgstr "Credits"

#: lib/vendors/openai/section.js:40
#, javascript-format
msgid "balance: %s"
msgstr "Guthaben: %s"

#: lib/vendors/openai/section.js:40
msgid "unlimited"
msgstr "unbegrenzt"

#. Translators: %s-%s is an approximate count range (e.g. "100-200").
#: lib/vendors/openai/section.js:43
#, javascript-format
msgid "~ %s-%s local messages"
msgstr "~ %s-%s lokale Nachrichten"

#. Translators: %s-%s is an approximate count range (e.g. "30-50").
#: lib/vendors/openai/section.js:46
#, javascript-format
msgid "~ %s-%s cloud messages"
msgstr "~ %s-%s Cloud-Nachrichten"

#. Translators: %s are money amounts, %s%% is the consumed percentage.
#: lib/vendors/openrouter/section.js:22
#, javascript-format
msgid "%s of %s used (%s%%)"
msgstr "%s von %s genutzt (%s%%)"

#: lib/vendors/openrouter/section.js:27
msgid "Usage"
msgstr "Nutzung"

#. Translators: %s are money amounts for the day, week and month to date.
#: lib/vendors/openrouter/section.js:31
#, javascript-format
msgid "today %s · week %s · month %s"
msgstr "heute %s · Woche %s · Monat %s"

#: lib/vendors/openrouter/section.js:38
msgid "Per-key limit"
msgstr "Limit pro Schlüssel"

#. Translators: %s are money amounts (remaining of limit).
#: lib/vendors/openrouter/section.js:42
#, javascript-format
msgid "%s of %s remaining"
msgstr "%s von %s übrig"

#: lib/vendors/openrouter/section.js:47
msgid "free tier"
msgstr "kostenlose Stufe"

#: lib/vendors/openrouter/section.js:47
msgid "paid tier"
msgstr "kostenpflichtige Stufe"

#: lib/vendors/section-common.js:40
#, javascript-format
msgid "HTTP %s"
msgstr "HTTP %s"

#: lib/vendors/section-common.js:51
#, javascript-format
msgid "Updated %s"
msgstr "Aktualisiert %s"

#: lib/vendors/zai/section.js:32
msgid "Session (5h)"
msgstr "Sitzung (5h)"

#: lib/vendors/zai/section.js:36
msgid "MCP tools (monthly)"
msgstr "MCP-Tools (monatlich)"

#: lib/vendors/zai/section.js:39
msgid "no usage windows reported"
msgstr "keine Nutzungsfenster gemeldet"

#: prefs.js:51
msgid "General"
msgstr "Allgemein"

#: prefs.js:55
msgid "Display"
msgstr "Anzeige"

#: prefs.js:61
msgid "Primary vendor"
msgstr "Primärer Anbieter"

#: prefs.js:62
msgid "Shown by default and used as the scroll-cycle reset target"
msgstr "Standardmäßig angezeigt und als Rücksetzziel beim Scrollen verwendet"

#: prefs.js:86
msgid "Refresh"
msgstr "Aktualisierung"

#. Translators: %d is the minimum refresh interval in seconds.
#: prefs.js:88
#, javascript-format
msgid "Minimum %d s — the upstream endpoints rate-limit below that."
msgstr "Minimum %d s — die Upstream-Endpunkte drosseln darunter."

#: prefs.js:97
msgid "Refresh interval (seconds)"
msgstr "Aktualisierungsintervall (Sekunden)"

#: prefs.js:120
msgid "Panel label"
msgstr "Panel-Beschriftung"

#. Translators: the {token} names are literal placeholders the user
#. types — keep them verbatim, only translate the surrounding prose.
#: prefs.js:123
msgid ""
"Placeholders: {vendor_short} {session_pct}% {session_reset} {plan} "
"{weekly_pct} {weekly_reset}"
msgstr ""
"Platzhalter: {vendor_short} {session_pct}% {session_reset} {plan} "
"{weekly_pct} {weekly_reset}"

#: prefs.js:125
msgid "Bar format"
msgstr "Balkenformat"

#: prefs.js:131
msgid "Popup"
msgstr "Popup"

#. Translators: the {token} names are literal placeholders the user
#. types — keep them verbatim, only translate the surrounding prose.
#: prefs.js:134
msgid ""
"Optional extra lines shown above the popup. Empty uses the built-in layout. "
"Placeholders: {plan} {session_pct} {session_reset} {weekly_pct} "
"{weekly_reset}"
msgstr ""
"Optionale zusätzliche Zeilen über dem Popup. Leer verwendet das eingebaute "
"Layout. Platzhalter: {plan} {session_pct} {session_reset} {weekly_pct} "
"{weekly_reset}"

#: prefs.js:136
msgid "Popup format"
msgstr "Popup-Format"

#: prefs.js:137
msgid "Show pace marker"
msgstr "Tempomarkierung anzeigen"

#: prefs.js:141
msgid "Severity colors"
msgstr "Schweregrad-Farben"

#: prefs.js:142
msgid ""
"Pick a color per severity tier. Reset returns a tier to its built-in default."
msgstr ""
"Wählen Sie eine Farbe pro Schweregrad. Zurücksetzen stellt den Standardwert "
"der Stufe wieder her."

#. Translators: Low/Mid/High/Critical are usage-severity tier names.
#: prefs.js:146
msgid "Low"
msgstr "Niedrig"

#: prefs.js:147
msgid "Mid"
msgstr "Mittel"

#: prefs.js:148
msgid "High"
msgstr "Hoch"

#: prefs.js:149
msgid "Critical"
msgstr "Kritisch"

#: prefs.js:153
msgid "Notifications"
msgstr "Benachrichtigungen"

#: prefs.js:154
msgid ""
"Show a desktop notification the first time a vendor reaches the threshold. "
"It re-arms when usage drops back or the window resets."
msgstr ""
"Zeigt eine Benachrichtigung an, sobald ein Anbieter den Schwellenwert "
"erreicht. Sie wird erneut ausgelöst, wenn die Nutzung fällt oder das Fenster "
"zurückgesetzt wird."

#: prefs.js:156
msgid "Notify on high usage"
msgstr "Bei hoher Nutzung benachrichtigen"

#: prefs.js:164
msgid "Notification threshold (%)"
msgstr "Benachrichtigungsschwelle (%)"

#: prefs.js:187 prefs.js:226
msgid "Reset"
msgstr "Zurücksetzen"

#: prefs.js:188
msgid ""
"Restore every setting — vendor toggles, paths, keys, formats, and colors — "
"to its built-in default."
msgstr ""
"Setzt jede Einstellung — Anbieter-Schalter, Pfade, Schlüssel, Formate und "
"Farben — auf den Standardwert zurück."

#: prefs.js:190
msgid "Reset all settings"
msgstr "Alle Einstellungen zurücksetzen"

#: prefs.js:222
msgid "Reset all settings?"
msgstr "Alle Einstellungen zurücksetzen?"

#: prefs.js:223
msgid ""
"This restores every setting to its built-in default and cannot be undone."
msgstr ""
"Dies setzt jede Einstellung auf ihren Standardwert zurück und kann nicht "
"rückgängig gemacht werden."

#: prefs.js:225
msgid "Cancel"
msgstr "Abbrechen"

#: prefs.js:245 prefs.js:249
msgid "Anthropic"
msgstr "Anthropic"

#: prefs.js:250
msgid "Credentials path — empty uses ~/.claude/.credentials.json."
msgstr "Anmeldedaten-Pfad — leer verwendet ~/.claude/.credentials.json."

#: prefs.js:252 prefs.js:268 prefs.js:284 prefs.js:302 prefs.js:319
msgid "Enabled"
msgstr "Aktiviert"

#: prefs.js:253
msgid "Credentials path"
msgstr "Anmeldedaten-Pfad"

#: prefs.js:261 prefs.js:265
msgid "OpenAI"
msgstr "OpenAI"

#: prefs.js:266
msgid "Codex auth path — empty uses ~/.codex/auth.json."
msgstr "Codex-Authentifizierungspfad — leer verwendet ~/.codex/auth.json."

#: prefs.js:269
msgid "Codex auth path"
msgstr "Codex-Authentifizierungspfad"

#: prefs.js:277 prefs.js:281
msgid "Z.AI"
msgstr "Z.AI"

#: prefs.js:282 prefs.js:300
msgid "Set the API key inline or via the environment variable (env wins)."
msgstr ""
"API-Schlüssel direkt oder über die Umgebungsvariable festlegen (Umgebung hat "
"Vorrang)."

#: prefs.js:285 prefs.js:303 prefs.js:320
msgid "API key env var"
msgstr "Umgebungsvariable des API-Schlüssels"

#: prefs.js:286 prefs.js:304 prefs.js:321
msgid "API key (inline)"
msgstr "API-Schlüssel (direkt)"

#: prefs.js:287
msgid "Plan tier (lite/pro/max)"
msgstr "Plan-Stufe (lite/pro/max)"

#: prefs.js:295 prefs.js:299
msgid "OpenRouter"
msgstr "OpenRouter"

#: prefs.js:312 prefs.js:316
msgid "DeepSeek"
msgstr "DeepSeek"

#: prefs.js:317
msgid "Disabled by default; requires an API key (env var or inline)."
msgstr ""
"Standardmäßig deaktiviert; erfordert einen API-Schlüssel (Umgebungsvariable "
"oder direkt)."

#: prefs.js:347
msgid "Reset to default"
msgstr "Auf Standard zurücksetzen"

