#: lib/countdown.js:9
msgid "now"
msgstr "jetzt"

#. Translators: compact countdown — d = days, h = hours.
#: lib/countdown.js:17
#, javascript-format
msgid "%dd %dh"
msgstr "%dT %dh"

#. Translators: compact countdown — h = hours, m = minutes (zero-padded).
#: lib/countdown.js:19
#, javascript-format
msgid "%dh %02dm"
msgstr "%dh %02dm"

#: lib/notify.js:47
msgid "Usage is critical"
msgstr "Nutzung kritisch"

#: lib/notify.js:48
#, javascript-format
msgid "Usage at %d%%"
msgstr "Nutzung bei %d%%"

#: lib/vendors/anthropic/section.js:28 lib/vendors/openai/section.js:23
#: lib/vendors/zai/section.js:22
#, javascript-format
msgid "Resets in %s"
