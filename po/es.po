#. Translators: "Anthropic" is a brand name, usually keep untranslated.
#: lib/prefs-pages.js
msgid "Anthropic"
msgstr "Anthropic"

#: lib/prefs-pages.js
msgid "Credentials path: empty uses ~/.claude/.credentials.json."
msgstr "Ruta de credenciales: vacío usa ~/.claude/.credentials.json."

#: lib/prefs-pages.js
msgid "Credentials path"
msgstr "Ruta de credenciales"

#: lib/prefs-pages.js
msgid "Context monitor"
msgstr "Monitor de contexto"

#: lib/prefs-pages.js
msgid ""
"Lists recent Claude Code sessions in the Claude section, with how much of "
"the context window each one used. Transcripts are read only while this is on."
msgstr ""
"Muestra las sesiones recientes de Claude Code en la sección de Claude, con "
"cuánto de la ventana de contexto usó cada una. Las transcripciones solo se "
"leen mientras esto esté activado."

#: lib/prefs-pages.js
msgid "Show session context"
msgstr "Mostrar el contexto de las sesiones"

