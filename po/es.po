msgstr ""
"Cualquier endpoint HTTPS que responda a un GET con JSON, asignado a filas de "
"uso mediante JSON Pointer. Consulta un ejemplo en el README."

#: prefs.js:529
msgid "Name"
msgstr "Nombre"

#: prefs.js:530
msgid "URL"
msgstr "URL"

#: prefs.js:531
msgid "Allow plain HTTP"
msgstr "Permitir HTTP sin cifrar"

#: prefs.js:535
msgid "Authentication"
msgstr "Autenticación"

#: prefs.js:536
msgid ""
"Without a key no auth header is sent. An empty scheme sends the key bare."
msgstr ""
"Sin clave no se envía ningún encabezado de autenticación. Un esquema vacío "
"envía la clave sola."

#: prefs.js:538
msgid "API key env var (optional)"
msgstr "Variable de entorno de la clave de API (opcional)"

#: prefs.js:540
msgid "Auth header"
msgstr "Encabezado de autenticación"

#: prefs.js:541
msgid "Auth scheme"
msgstr "Esquema de autenticación"

#: prefs.js:545
msgid "Extra headers"
msgstr "Encabezados extra"

#: prefs.js:546
msgid ""
"A JSON object of header names to string values; it must not repeat the auth "
"header."
msgstr ""
"Un objeto JSON de nombres de encabezado a valores de texto; no puede repetir "
"el encabezado de autenticación."

#: prefs.js:551
msgid ""
"Not a JSON object of string header values, or it repeats the auth header."
msgstr ""
"No es un objeto JSON de valores de encabezado de texto, o repite el "
"encabezado de autenticación."

#: prefs.js:557
msgid "Mapping"
msgstr "Mapeo"

#: prefs.js:558
msgid ""
"Metrics (used + limit, or percent) and texts, each read from the response by "
"JSON Pointer. Saved when the editor loses focus and the mapping is valid."
msgstr ""
"Métricas (usado + límite, o porcentaje) y textos, cada uno leído de la "
"respuesta mediante JSON Pointer. Se guarda cuando el editor pierde el foco y "
"el mapeo es válido."

#: prefs.js:565
#, javascript-format
msgid "Not valid JSON: %s"
msgstr "JSON no válido: %s"

#: prefs.js:644 prefs.js:692
msgid "Reset to default"
msgstr "Restablecer al valor predeterminado"

#: prefs.js:685
msgid "Disabled"
msgstr "Desactivado"

#: prefs.js:720
msgid "Set shortcut"
msgstr "Definir atajo"

#: prefs.js:721
msgid "Press the new shortcut for opening the popup, or Esc to cancel."
msgstr ""
"Pulse el nuevo atajo para abrir la ventana emergente, o Esc para cancelar."

#: prefs.js:724
msgid "Disable"
msgstr "Desactivar"

#: ui/indicator.js:97
msgid "No panel vendors selected"
msgstr "No hay proveedores seleccionados para el panel"

#: ui/indicator.js:118
msgid "Refresh now"
msgstr "Actualizar ahora"

#: ui/indicator.js:120
msgid "Refresh all"
msgstr "Actualizar todo"

#: ui/indicator.js:122
msgid "Preferences"
msgstr "Preferencias"

#: ui/indicator.js:322
msgid "No data: use \"Refresh all\""
msgstr "Sin datos: use \"Actualizar todo\""

#: ui/indicator.js:346 ui/indicator.js:591
msgid "Loading…"
msgstr "Cargando…"

