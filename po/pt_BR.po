msgstr "Semanal"

#: lib/vendors/anthropic/section.js:40
msgid "Sonnet only"
msgstr "Apenas Sonnet"

#: lib/vendors/anthropic/section.js:47
msgid "Extra usage"
msgstr "Uso extra"

#: lib/vendors/anthropic/section.js:50
#, javascript-format
msgid "Limit: %s"
msgstr "Limite: %s"

#. Translators: %s is the Anthropic plan name (e.g. "Max 5x") — kept verbatim.
#: lib/vendors/anthropic/section.js:62
#, javascript-format
msgid "Claude %s"
msgstr "Claude %s"

#: lib/vendors/deepseek/section.js:16 lib/vendors/openrouter/section.js:18
msgid "Balance"
msgstr "Saldo"

#. Translators: %s are money amounts (granted credit, topped-up credit).
#: lib/vendors/deepseek/section.js:20
#, javascript-format
msgid "granted %s · topped-up %s"
msgstr "concedido %s · recarga %s"

#: lib/vendors/deepseek/section.js:28
msgid "API available"
msgstr "API disponível"

#: lib/vendors/deepseek/section.js:28
msgid "API unavailable"
msgstr "API indisponível"

#: lib/vendors/openai/section.js:32
msgid "Codex 5h"
msgstr "Codex 5h"

#: lib/vendors/openai/section.js:33
msgid "Codex weekly"
msgstr "Codex semanal"

#: lib/vendors/openai/section.js:35
msgid "Code review (weekly)"
msgstr "Revisão de código (semanal)"

#: lib/vendors/openai/section.js:39
msgid "Credits"
msgstr "Créditos"

#: lib/vendors/openai/section.js:40
#, javascript-format
msgid "balance: %s"
msgstr "saldo: %s"

#: lib/vendors/openai/section.js:40
msgid "unlimited"
msgstr "ilimitado"

#. Translators: %s-%s is an approximate count range (e.g. "100-200").
#: lib/vendors/openai/section.js:43
#, javascript-format
msgid "~ %s-%s local messages"
msgstr "~ %s-%s mensagens locais"

#. Translators: %s-%s is an approximate count range (e.g. "30-50").
#: lib/vendors/openai/section.js:46
#, javascript-format
msgid "~ %s-%s cloud messages"
msgstr "~ %s-%s mensagens na nuvem"

#. Translators: %s are money amounts, %s%% is the consumed percentage.
#: lib/vendors/openrouter/section.js:22
#, javascript-format
msgid "%s of %s used (%s%%)"
msgstr "%s de %s usado (%s%%)"

#: lib/vendors/openrouter/section.js:27
msgid "Usage"
msgstr "Uso"

#. Translators: %s are money amounts for the day, week and month to date.
#: lib/vendors/openrouter/section.js:31
#, javascript-format
msgid "today %s · week %s · month %s"
msgstr "hoje %s · semana %s · mês %s"

#: lib/vendors/openrouter/section.js:38
msgid "Per-key limit"
msgstr "Limite por chave"

#. Translators: %s are money amounts (remaining of limit).
#: lib/vendors/openrouter/section.js:42
#, javascript-format
msgid "%s of %s remaining"
msgstr "%s de %s restante"

#: lib/vendors/openrouter/section.js:47
msgid "free tier"
msgstr "plano gratuito"

#: lib/vendors/openrouter/section.js:47
msgid "paid tier"
msgstr "plano pago"

#: lib/vendors/section-common.js:40
#, javascript-format
msgid "HTTP %s"
msgstr "HTTP %s"

#: lib/vendors/section-common.js:51
#, javascript-format
msgid "Updated %s"
msgstr "Atualizado %s"

#: lib/vendors/zai/section.js:32
msgid "Session (5h)"
msgstr "Sessão (5h)"

#: lib/vendors/zai/section.js:36
msgid "MCP tools (monthly)"
msgstr "Ferramentas MCP (mensal)"

#: lib/vendors/zai/section.js:39
msgid "no usage windows reported"
msgstr "nenhuma janela de uso informada"

#: prefs.js:51
msgid "General"
msgstr "Geral"

#: prefs.js:55
msgid "Display"
msgstr "Exibição"

#: prefs.js:61
msgid "Primary vendor"
msgstr "Fornecedor principal"

#: prefs.js:62
msgid "Shown by default and used as the scroll-cycle reset target"
msgstr "Exibido por padrão e usado como alvo de reinício ao rolar"

#: prefs.js:86
msgid "Refresh"
msgstr "Atualização"

#. Translators: %d is the minimum refresh interval in seconds.
#: prefs.js:88
#, javascript-format
msgid "Minimum %d s — the upstream endpoints rate-limit below that."
msgstr "Mínimo %d s — os endpoints upstream limitam a taxa abaixo disso."

#: prefs.js:97
msgid "Refresh interval (seconds)"
msgstr "Intervalo de atualização (segundos)"

#: prefs.js:120
msgid "Panel label"
msgstr "Rótulo do painel"

#. Translators: the {token} names are literal placeholders the user
#. types — keep them verbatim, only translate the surrounding prose.
#: prefs.js:123
msgid ""
"Placeholders: {vendor_short} {session_pct}% {session_reset} {plan} "
"{weekly_pct} {weekly_reset}"
msgstr ""
"Espaços reservados: {vendor_short} {session_pct}% {session_reset} {plan} "
"{weekly_pct} {weekly_reset}"

#: prefs.js:125
msgid "Bar format"
msgstr "Formato da barra"

#: prefs.js:131
msgid "Popup"
msgstr "Popup"

#. Translators: the {token} names are literal placeholders the user
#. types — keep them verbatim, only translate the surrounding prose.
#: prefs.js:134
msgid ""
"Optional extra lines shown above the popup. Empty uses the built-in layout. "
"Placeholders: {plan} {session_pct} {session_reset} {weekly_pct} "
"{weekly_reset}"
msgstr ""
"Linhas extras opcionais mostradas acima do popup. Vazio usa o layout "
"interno. Espaços reservados: {plan} {session_pct} {session_reset} "
"{weekly_pct} {weekly_reset}"

#: prefs.js:136
msgid "Popup format"
msgstr "Formato do popup"

#: prefs.js:137
msgid "Show pace marker"
msgstr "Mostrar marcador de ritmo"

#: prefs.js:141
msgid "Severity colors"
msgstr "Cores de severidade"

#: prefs.js:142
msgid ""
"Pick a color per severity tier. Reset returns a tier to its built-in default."
msgstr ""
"Escolha uma cor para cada nível de severidade. Redefinir retorna o nível ao "
"seu padrão interno."

#. Translators: Low/Mid/High/Critical are usage-severity tier names.
#: prefs.js:146
msgid "Low"
msgstr "Baixo"

#: prefs.js:147
msgid "Mid"
msgstr "Médio"

#: prefs.js:148
msgid "High"
msgstr "Alto"

#: prefs.js:149
msgid "Critical"
msgstr "Crítico"

#: prefs.js:153
msgid "Notifications"
msgstr "Notificações"

#: prefs.js:154
msgid ""
"Show a desktop notification the first time a vendor reaches the threshold. "
"It re-arms when usage drops back or the window resets."
msgstr ""
"Mostra uma notificação na primeira vez que um provedor atinge o limite. É "
"rearmada quando o uso cai ou a janela é reiniciada."

#: prefs.js:156
msgid "Notify on high usage"
msgstr "Notificar em uso elevado"

#: prefs.js:164
msgid "Notification threshold (%)"
msgstr "Limite de notificação (%)"

#: prefs.js:187 prefs.js:226
msgid "Reset"
msgstr "Restaurar"

#: prefs.js:188
msgid ""
"Restore every setting — vendor toggles, paths, keys, formats, and colors — "
"to its built-in default."
msgstr ""
"Restaura todas as configurações — alternâncias de fornecedores, caminhos, "
"chaves, formatos e cores — para o padrão original."

#: prefs.js:190
msgid "Reset all settings"
msgstr "Restaurar todas as configurações"

#: prefs.js:222
msgid "Reset all settings?"
msgstr "Restaurar todas as configurações?"

#: prefs.js:223
msgid ""
"This restores every setting to its built-in default and cannot be undone."
msgstr ""
"Isso restaura todas as configurações para o padrão original e não pode ser "
"desfeito."

#: prefs.js:225
msgid "Cancel"
msgstr "Cancelar"

