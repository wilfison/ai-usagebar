"{vendor_short} {session_pct}% {session_reset} {plan} {weekly_pct} "
"{weekly_reset}"
msgstr ""
"Deixe o rótulo de um provedor vazio para usar o rótulo padrão. Marcadores: "
"{vendor_short} {session_pct}% {session_reset} {plan} {weekly_pct} "
"{weekly_reset}"

#: prefs.js:205
