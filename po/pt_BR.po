#: lib/countdown.js:9
msgid "now"
msgstr "agora"

#. Translators: compact countdown — d = days, h = hours.
#: lib/countdown.js:17
#, javascript-format
msgid "%dd %dh"
msgstr "%dd %dh"

#. Translators: compact countdown — h = hours, m = minutes (zero-padded).
#: lib/countdown.js:19
#, javascript-format
msgid "%dh %02dm"
msgstr "%dh %02dm"

#: lib/notify.js:47
msgid "Usage is critical"
msgstr "Uso crítico"

#: lib/notify.js:48
#, javascript-format
msgid "Usage at %d%%"
msgstr "Uso em %d%%"

#: lib/vendors/anthropic/section.js:28 lib/vendors/openai/section.js:23
#: lib/vendors/zai/section.js:22
#, javascript-format
msgid "Resets in %s"
msgstr "Reinicia em %s"

#: lib/vendors/anthropic/section.js:37
msgid "Session"
msgstr "Sessão"

#: lib/vendors/anthropic/section.js:38 lib/vendors/zai/section.js:34
