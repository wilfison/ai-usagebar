"Defina a chave de API embutida ou via variável de ambiente (ambiente "
"prevalece)."

#: prefs.js:285 prefs.js:303 prefs.js:320
msgid "API key env var"
msgstr "Variável de ambiente da chave de API"

#: prefs.js:286 prefs.js:304 prefs.js:321
msgid "API key (inline)"
msgstr "Chave de API (embutida)"

#: prefs.js:287
msgid "Plan tier (lite/pro/max)"
msgstr "Nível do plano (lite/pro/max)"

#: prefs.js:295 prefs.js:299
msgid "OpenRouter"
msgstr "OpenRouter"

#: prefs.js:312 prefs.js:316
msgid "DeepSeek"
msgstr "DeepSeek"

#: prefs.js:317
msgid "Disabled by default; requires an API key (env var or inline)."
msgstr ""
"Desativado por padrão; requer uma chave de API (variável de ambiente ou "
"embutida)."

#: prefs.js:347
msgid "Reset to default"
msgstr "Redefinir para o padrão"

