#: lib/countdown.js:9
msgid "now"
msgstr "maintenant"

#. Translators: compact countdown — d = days, h = hours.
#: lib/countdown.js:17
#, javascript-format
msgid "%dd %dh"
msgstr "%dj %dh"

#. Translators: compact countdown — h = hours, m = minutes (zero-padded).
#: lib/countdown.js:19
#, javascript-format
msgid "%dh %02dm"
msgstr "%dh %02dm"

#: lib/notify.js:47
msgid "Usage is critical"
msgstr "Utilisation critique"

#: lib/notify.js:48
#, javascript-format
msgid "Usage at %d%%"
