msgid ""
"Leave a vendor label empty to use the default label. Placeholders: "
"{vendor_short} {session_pct}% {session_reset} {plan} {weekly_pct} "
"{weekly_reset}"
msgstr ""
"Laissez le libellé d’un fournisseur vide pour utiliser le libellé par "
"défaut. Variables : {vendor_short} {session_pct}% {session_reset} {plan} "
"{weekly_pct} {weekly_reset}"

#: prefs.js:205
msgid "Default label"
msgstr "Libellé par défaut"

#. Translators: the {token} names are literal placeholders the user
#. types: keep them verbatim, only translate the surrounding prose.
#: prefs.js:223
